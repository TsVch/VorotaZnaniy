# ---- Application ----
APP_ENV=development
APP_URL=http://localhost:3000
PORT=8000

# ---- Internal API (Backend NestJS for HTTP Bridge) ----
INTERNAL_API_URL=http://backend:4000
INTERNAL_API_KEY=change-me-in-production-generate-a-random-key

# ---- PostgreSQL Database ----
DATABASE_URL=postgresql://change-me-user:change-me-password@localhost:5432/knowledgevault_dev

# ---- LLM Provider ----
OPENAI_API_KEY=sk-change-me-in-production
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Monitoring ----
SENTRY_DSN=https://change-me-in-production@sentry.io/123456
