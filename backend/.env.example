# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=4000

# ---- PostgreSQL Database ----
DATABASE_URL=postgresql://change-me-user:change-me-password@localhost:5432/knowledgevault_dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT Authentication ----
JWT_SECRET=change-me-in-production-generate-a-random-256-bit-secret
JWT_REFRESH_SECRET=change-me-in-production-generate-another-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- YooKassa (Payments — MVP) ----
# Get these from https://yookassa.ru/my/merchant
YOOKASSA_SHOP_ID=change-me-in-production
YOOKASSA_SECRET_KEY=change-me-in-production
YOOKASSA_WEBHOOK_SECRET=change-me-in-production

# Active payment provider: yookassa | mock | tbank | stripe
#   yookassa — real YooKassa (production-ready, default)
#   mock     — simulated payments for internal testing (BLOCKED in NODE_ENV=production)
PAYMENT_PROVIDER_ACTIVE=yookassa

# ---- Legacy Stripe (to be removed in Phase 2) ----
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change-me-in-production
# STRIPE_SECRET_KEY=sk_test_change-me-in-production
# STRIPE_WEBHOOK_SECRET=whsec_change-me-in-production

# ---- Cloudflare R2 / AWS S3 (Object Storage) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me-in-production
S3_SECRET_ACCESS_KEY=change-me-in-production
S3_BUCKET=knowledgevault-dev
S3_UPLOAD_URL_EXPIRY=300
S3_VIEW_URL_EXPIRY=60

# ---- AI / LLM Provider ----
OPENAI_API_KEY=sk-change-me-in-production
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Email Service (Resend) ----
# Resend is used for transactional emails: Magic Link, purchase confirmation, security alerts.
# When not configured, emails are logged to the console for local development.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_change-me-in-production
EMAIL_FROM=noreply@knowledgevault.com
APP_URL=http://localhost:4000

# ---- OAuth Providers ----
GOOGLE_CLIENT_ID=change-me-in-production.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-in-production
GITHUB_CLIENT_ID=change-me-in-production
GITHUB_CLIENT_SECRET=change-me-in-production

# ---- Monitoring & Observability ----
SENTRY_DSN=https://change-me-in-production@sentry.io/123456
SENTRY_ENVIRONMENT=development

# ---- OAuth Redirect & Frontend URL ----
FRONTEND_URL=http://localhost:3001
OAUTH_REDIRECT_URI=http://localhost:4000/v1

# ---- Magic Link Authentication ----
MAGIC_LINK_EXPIRY_MINUTES=15
# RESEND_API_KEY=re_change-me-in-production   # Uncomment when integrating real email

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=5
