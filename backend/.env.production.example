# =============================================================================
# KnowledgeVault SaaS — Backend Environment Variables (Production / Staging)
# =============================================================================
# Set these variables in your Render Dashboard:
#   Render Dashboard → Your Service → Environment → Environment Variables
#
# ⚠️  NEVER commit real values. Use Render Dashboard or GitHub Secrets.
# =============================================================================

# ---- Application ----
NODE_ENV=production
PORT=10000

# Public URL of your frontend (no trailing slash!)
# This is used for CORS and OAuth redirects
FRONTEND_URL=https://staging.knowledgevault.com

# Backend's own URL (used for Magic Link and YooKassa return URLs)
APP_URL=https://knowledgevault-api.onrender.com

# ---- PostgreSQL Database ----
# Render provides this automatically via the Blueprint.
# For manual setup: postgresql://user:password@host:5432/knowledgevault
DATABASE_URL=postgresql://user:password@host:5432/knowledgevault

# ---- Redis ----
# Render provides this automatically via the Blueprint.
# For manual setup: redis://host:6379
REDIS_URL=redis://host:6379

# ---- JWT Authentication ----
JWT_SECRET=generate-a-random-256-bit-secret-here
JWT_REFRESH_SECRET=generate-another-random-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- YooKassa (Payments — MVP) ----
# Get these from https://yookassa.ru/my/merchant
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret
PAYMENT_PROVIDER_ACTIVE=yookassa

# ---- Cloudflare R2 / AWS S3 (Object Storage) ----
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=knowledgevault-staging
S3_UPLOAD_URL_EXPIRY=300
S3_VIEW_URL_EXPIRY=60

# ---- AI / LLM Provider ----
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Email Service (Resend) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@knowledgevault.com

# ---- OAuth Providers ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# ---- Magic Link ----
MAGIC_LINK_EXPIRY_MINUTES=15

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=5

# ---- Monitoring ----
SENTRY_DSN=https://your-dsn@sentry.io/123456
SENTRY_ENVIRONMENT=staging

# ---- Legacy (stripped) ----
# Stripe is not used in MVP. YooKassa is the active provider.
