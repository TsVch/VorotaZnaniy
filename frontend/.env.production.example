# =============================================================================
# KnowledgeVault SaaS — Frontend Environment Variables (Production / Staging)
# =============================================================================
# Copy this file contents to your Vercel project's Environment Variables:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
# ⚠️  NEVER commit real values. Always use the Vercel Dashboard.
# =============================================================================

# ---- Application ----
# Public URL of your frontend (no trailing slash!)
NEXT_PUBLIC_APP_URL=https://staging.knowledgevault.com

# Backend API URL (your Render/Railway backend URL, no trailing slash!)
NEXT_PUBLIC_API_URL=https://knowledgevault-api.onrender.com/v1

# ---- Sentry (optional) ----
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/123456

# ---- Google Analytics (optional) ----
NEXT_PUBLIC_GA_ID=G-change-me-in-production
