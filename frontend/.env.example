# =============================================================================
# KnowledgeVault SaaS — Frontend Environment Variables
# =============================================================================
# Public variables (exposed to browser): prefix with NEXT_PUBLIC_
# Private variables (server-only): no prefix needed
# =============================================================================

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Stripe (public key only) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change-me-in-production

# ---- Monitoring (public DSN) ----
NEXT_PUBLIC_SENTRY_DSN=https://change-me-in-production@sentry.io/123456

# ---- Analytics ----
NEXT_PUBLIC_GA_ID=G-change-me-in-production
